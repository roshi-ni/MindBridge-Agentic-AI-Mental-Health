
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MindBridge — Project Summary</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, "Segoe UI", system-ui, sans-serif; font-size: 14px; line-height: 1.6; background: #f0f4f8; color: #1f2328; }
  .page { max-width: 760px; margin: 0 auto; padding: 2rem 1.5rem 3rem; }

  /* Header */
  .header { background: linear-gradient(135deg, #1a56db 0%, #7c3aed 100%); color: white; padding: 2rem; border-radius: 14px; text-align: center; margin-bottom: 2rem; }
  .header h1 { font-size: 2rem; font-weight: 700; margin-bottom: .3rem; }
  .header p { font-size: .9rem; opacity: .88; }
  .badge { display: inline-block; background: rgba(255,255,255,.2); border: 1px solid rgba(255,255,255,.35); border-radius: 20px; padding: 3px 12px; font-size: .8rem; margin: .4rem .2rem 0; }

  /* Section */
  .section { background: white; border: 1px solid #e5e7eb; border-radius: 12px; padding: 1.4rem 1.5rem; margin-bottom: 1.2rem; }
  .section h2 { font-size: 1rem; font-weight: 700; color: #1a56db; margin-bottom: .9rem; display: flex; align-items: center; gap: .5rem; }

  /* Grid */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: .8rem; }

  /* Card */
  .card { background: #f7f8fa; border: 1px solid #e5e7eb; border-radius: 9px; padding: .9rem 1rem; }
  .card h3 { font-size: .85rem; font-weight: 700; margin-bottom: .3rem; }
  .card p, .card li { font-size: .82rem; color: #374151; }
  .card ul { padding-left: 1.1rem; }

  /* Metric */
  .metric { text-align: center; background: #f7f8fa; border: 1px solid #e5e7eb; border-radius: 9px; padding: .9rem; }
  .metric .num { font-size: 1.8rem; font-weight: 700; color: #1a56db; line-height: 1; }
  .metric .lbl { font-size: .75rem; color: #6b7280; margin-top: .2rem; }

  /* Table */
  table { width: 100%; border-collapse: collapse; font-size: .82rem; }
  th { background: #f7f8fa; font-weight: 600; text-align: left; padding: .5rem .75rem; border-bottom: 2px solid #e5e7eb; }
  td { padding: .45rem .75rem; border-bottom: 1px solid #f3f4f6; }
  tr:last-child td { border-bottom: none; }

  /* Risk pills */
  .pill { display: inline-block; padding: 2px 9px; border-radius: 10px; font-size: .75rem; font-weight: 600; }
  .p-none { background: #d1fae5; color: #065f46; }
  .p-low  { background: #dbeafe; color: #1e40af; }
  .p-med  { background: #fef3c7; color: #92400e; }
  .p-high { background: #fee2e2; color: #991b1b; }
  .p-crit { background: #fce7f3; color: #9d174d; }

  /* Flow */
  .flow { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  .flow-node { background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 8px; padding: .35rem .7rem; font-size: .78rem; font-weight: 600; color: #1e40af; white-space: nowrap; }
  .flow-arrow { color: #9ca3af; font-size: 1rem; }

  /* Test result */
  .test-row { display: flex; justify-content: space-between; align-items: center; padding: .4rem 0; border-bottom: 1px solid #f3f4f6; font-size: .83rem; }
  .test-row:last-child { border: none; }
  .pass { color: #059669; font-weight: 700; }

  .warn { background: #fffbeb; border-left: 4px solid #f59e0b; padding: .6rem .9rem; border-radius: 0 8px 8px 0; font-size: .8rem; color: #78350f; margin-top: .6rem; }

  footer { text-align: center; font-size: .72rem; color: #9ca3af; border-top: 1px solid #e5e7eb; padding-top: 1.2rem; margin-top: 2rem; }
</style>
</head>
